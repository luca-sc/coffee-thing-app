# ===== Configurare server =====
# Backend-ul ruleaza pe portul 3000 (conform listei de verificare integrare)
PORT=5000

# URL-ul frontend-ului pentru CORS (Vite ruleaza implicit pe 5173)
CLIENT_URL=http://localhost:5173

# ===== Configurare baza de date MySQL =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=coffee_thing

# Baza de date folosita la rularea testelor (separata de cea de productie)
DB_NAME_TEST=coffee_thing_test

# ===== Configurare JWT =====
# IMPORTANT: schimba acest secret cu unul aleator in productie
JWT_SECRET=schimba_acest_secret_cu_unul_lung_si_aleator
JWT_EXPIRES_IN=24h
