{
  "name": "coffee-thing-backend",
  "version": "1.0.0",
  "description": "Backend Node + Express + MySQL pentru aplicatia coffee-thing-app (autentificare, logica de business, CRUD)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "init-db": "node src/scripts/init-db.js",
    "init-db:test": "cross-env NODE_ENV=test node src/scripts/init-db.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles",
    "test:unit": "cross-env NODE_ENV=test jest tests/unit --runInBand",
    "test:integration": "cross-env NODE_ENV=test jest tests/integration --runInBand --detectOpenHandles"
  },
  "keywords": ["express", "mysql", "jwt", "rest-api"],
  "author": "Elgat09",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
